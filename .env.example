# The ONLY config file for local development: copy to .env (git-ignored) and adjust.
#   API (dotnet run)       reads it via DotNetEnv
#   Function (func start)  reads it via DotNetEnv (DATABASE_URL, BLOB_CONNECTION_STRING)
#   Frontend (npm run dev) reads it via Vite (API_PORT, WEB_PORT, VITE_*)
#   docker compose         reads it automatically for ${...} interpolation
# Values below are for LOCAL DEVELOPMENT ONLY. Azure gets its settings from Bicep / Key Vault.

ENVIRONMENT=Development

# --- Ports on your machine ---
API_PORT=5041
WEB_PORT=3000
DB_PORT=1433

# --- Database ---
DB_NAME=PdfShare
# Password of the SQL Server container (docker compose); also used in DATABASE_URL below.
DB_PASSWORD=LocalDev_Passw0rd!
# Used when the API / Function run on the host. docker compose builds its own (host "db") from DB_NAME/DB_PASSWORD.
# Without Docker (Windows LocalDB):
DATABASE_URL=Server=(localdb)\MSSQLLocalDB;Database=PdfShare;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True
# With "docker compose up db azurite":
# DATABASE_URL=Server=localhost,1433;Database=PdfShare;User Id=sa;Password=LocalDev_Passw0rd!;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=True

# --- Auth ---
# At least 32 characters. Generate: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- Storage (Azurite) ---
# Host run: UseDevelopmentStorage=true. docker compose uses its own (host "azurite").
BLOB_CONNECTION_STRING=UseDevelopmentStorage=true
# Rewrites the host in SAS download URLs so the browser can reach Azurite (empty in Azure).
BLOB_PUBLIC_BASE_URL=http://localhost:10000

# --- Frontend ---
# Base URL of the API as the browser sees it. Keep "/api": vite (dev) and nginx (Docker/Azure)
# proxy it to the backend, so no CORS is needed and the refresh cookie can be SameSite=Strict.
VITE_API_BASE_URL=/api
# Only needed when the SPA calls the API directly instead of through the /api proxy.
CORS_ORIGINS=

# --- Demo data: creates alice@pdfshare.local and bob@pdfshare.local ---
SEED_DEMO_USERS=true
SEED_DEMO_PASSWORD=Demo_Passw0rd!
