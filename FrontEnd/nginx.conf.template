# Rendered by the nginx image entrypoint (envsubst of defined env vars only) into
# /etc/nginx/conf.d/default.conf. API_UPSTREAM: http://backend:8080 (compose) or the internal
# Container Apps URL of pdfshare-api (Azure).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Same-origin API: /api/files -> ${API_UPSTREAM}/files (trailing slash strips the prefix).
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        # Host stays $proxy_host (nginx default): Container Apps internal ingress routes by it.
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        client_max_body_size 21m;
        proxy_read_timeout 120s;
    }

    # Hashed build output: cache forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA shell must always be revalidated so new deployments are picked up.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
